# Sao chép file này thành `.env.local` rồi điền giá trị thật.
# KHÔNG commit `.env.local`.

# ── Stripe ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Lấy từ Stripe Dashboard > Developers > Webhooks, hoặc `stripe listen`
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Cloudinary ──────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Firebase Admin ──────────────────────────────────────
# JSON service account, mã hoá base64:
#   node -e "console.log(Buffer.from(require('fs').readFileSync('serviceAccount.json')).toString('base64'))"
FIREBASE_SERVICE_ACCOUNT_BASE64=base64_encoded_service_account_json

# ── App ─────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://your-domain.vercel.app
